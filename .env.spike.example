# SPIKE: copy to .env and fill in. Never commit .env.
# Knock dashboard -> Developers -> API keys (Development environment, secret key)
KNOCK_SECRET_API_KEY=
# Knock dashboard -> Integrations -> Channels -> your FCM channel -> channel id (UUID)
KNOCK_FCM_CHANNEL_ID=
# Knock workflow key with one Push step on the FCM channel
KNOCK_WORKFLOW_KEY=spike-push
# Firebase console -> Project settings -> General -> Your apps (web app config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates -> key pair
FIREBASE_VAPID_KEY=
